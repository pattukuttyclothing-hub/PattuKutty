PORT=3001
NODE_ENV=development
# CORS allowed frontend domains (Comma-separated or '*' for any origin)
ALLOWED_ORIGINS="https://customer-app.example.com,https://admin-app.example.com"
# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 Credentials
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=butterflies-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.butterfliestailoring.com

# n8n Webhook Automation Engine
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# WhatsApp & Phone Contact Numbers
WHATSAPP_NUMBER="919345520768"
STORE_PHONE="+91 93455 20768"


# Razorpay Gateway (backend-only — never expose secret to frontend)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Blue Dart Courier Integration (backend-only — never expose to frontend)
# Obtain from your Blue Dart account portal / account manager
BLUEDART_API_KEY=your-bluedart-api-key
BLUEDART_API_SECRET=your-bluedart-api-secret
BLUEDART_LOGIN_ID=your-bluedart-login-id
BLUEDART_LICENSE_KEY=your-bluedart-license-key
BLUEDART_API_TYPE=S
BLUEDART_API_URL=https://netconnect.bluedart.com
# Modular Base URLs (optional overrides)
# BLUEDART_AUTH_BASE_URL=https://apigateway.bluedart.com
# BLUEDART_WAYBILL_BASE_URL=https://netconnect.bluedart.com
# BLUEDART_PICKUP_BASE_URL=https://netconnect.bluedart.com
# BLUEDART_TRACKING_BASE_URL=https://netconnect.bluedart.com
# BLUEDART_CANCEL_PICKUP_BASE_URL=https://netconnect.bluedart.com
# BLUEDART_PRODUCT_BASE_URL=https://netconnect.bluedart.com

# Blue Dart Product Codes — confirm exact values with your Blue Dart account representative
# BLUEDART_PREPAID_PRODUCT_CODE=A       # Dart Apex / equivalent prepaid product
# BLUEDART_COD_PRODUCT_CODE=D           # COD product code — MUST confirm before use
# BLUEDART_ORIGIN_AREA=CJB             # Your origin area code (e.g. CJB = Coimbatore)
# BLUEDART_CUSTOMER_CODE=12345          # Your Blue Dart customer code

